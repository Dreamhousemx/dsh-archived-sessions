{
  "name": "dsh-archived-sessions",
  "version": "1.0.1",
  "private": true,
  "description": "DeepSeek Harness settings page for archived sessions: search by workspace, restore, and delete.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sessions",
    "archive"
  ],
  "author": "Elio.Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dreamhousemx/dsh-archived-sessions.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "*.cmd",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "manifestVersion": 1
  }
}
